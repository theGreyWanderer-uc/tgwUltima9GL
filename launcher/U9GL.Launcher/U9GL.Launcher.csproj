<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>U9GL</AssemblyName>
    <RootNamespace>U9GL.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\U9GL.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\U9GL.Core\U9GL.Core.csproj" />
    <ProjectReference Include="..\U9GL.WebDashboard\U9GL.WebDashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\U9GL.ico" />
    <Resource Include="Resources\About.png" />
    <Resource Include="Effects\OnWhiteToAlpha.ps" />
    <None Include="Effects\OnWhiteToAlpha.fx" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Notices/QRCoder-LICENSE.txt" Link="licenses/QRCoder-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Media\about.mp4" Link="media\about.mp4" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
