<UserControl x:Class="U9GL.Launcher.Views.DiagnosticsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Diagnostics" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"
                   Text="What U9GL writes to its log while you play (%TEMP%\u9log.txt). These only watch the game; turning one off or on changes nothing in it. Changes apply the next time the game starts." />
        <TextBlock Style="{StaticResource WarningTextStyle}" Margin="0,0,0,4"
                   Visibility="{Binding DiagIniPresent, Converter={StaticResource BoolToVisibility}}"
                   Text="u9gl.diag.ini is in the u9gl folder. The switches show what it sets; saving a change to one takes its line out of that file." />
        <Border Height="16" />

        <ItemsControl ItemsSource="{Binding Settings}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Margin="0,0,-12,0"
                               ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self},
                                                   Converter={StaticResource Fraction}, ConverterParameter=0.5}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="{Binding Help}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                      IsChecked="{Binding IsSwitchOn}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Title}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
