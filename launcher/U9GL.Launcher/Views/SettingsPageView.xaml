<UserControl x:Class="U9GL.Launcher.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,20" />

        <ItemsControl ItemsSource="{Binding Settings}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TwoColumns}" Value="True">
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Margin="0,0,-12,0"
                                                   ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self},
                                                                       Converter={StaticResource Fraction}, ConverterParameter=0.5}" />
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.TwoColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                        <Setter Property="Margin" Value="0,0,12,12" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Text="{Binding Help}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{Binding SingleNote}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                                           Visibility="{Binding SingleNote, Converter={StaticResource TextToVisibility}}" />
                                <TextBlock Text="{Binding PageNote}" Style="{StaticResource WarningTextStyle}" Margin="0,4,0,0"
                                           Visibility="{Binding PageNote, Converter={StaticResource TextToVisibility}}" />
                                <TextBlock Text="{Binding DiagNote}" Style="{StaticResource ErrorTextStyle}" Margin="0,4,0,0"
                                           Visibility="{Binding DiagNote, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>

                            <Grid VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Width" Value="260" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.TwoColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                <Setter Property="Grid.Column" Value="0" />
                                                <Setter Property="Grid.Row" Value="1" />
                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Margin" Value="0,10,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <ComboBox VerticalAlignment="Center"
                                          ItemsSource="{Binding PageChoices}"
                                          SelectedItem="{Binding PageSelected}"
                                          DisplayMemberPath="Label"
                                          Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SingleValueText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <Button Content="Use the verified value" Command="{Binding UseVerifiedCommand}"
                                            HorizontalAlignment="Right" Margin="0,6,0,0" Padding="12,4"
                                            Visibility="{Binding CanUseVerified, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal"
                                    Visibility="{Binding PageAllowsCustom, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Or a custom value:" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ItemsControl ItemsSource="{Binding CustomValues}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Use these" Command="{Binding ApplyCustomCommand}" Padding="14,4" />
                        </StackPanel>
                        <TextBlock Text="{Binding CustomError}" Style="{StaticResource ErrorTextStyle}" Margin="0,6,0,0"
                                   Visibility="{Binding CustomError, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
