<UserControl x:Class="U9GL.Launcher.Views.WebDashboardPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel DataContext="{Binding Main}">
        <TextBlock Text="Web Dashboard" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="The game's diagnostics in a browser: frame rate, memory, textures, the world around the Avatar, the game log and GPU time. Open it on this PC, or on a phone, tablet or another PC on your network."
                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="Server" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <CheckBox Content="Enable the local web dashboard"
                          IsChecked="{Binding WebDashboard.Enabled}" IsEnabled="{Binding WebDashboard.CanChange}" />
                <TextBlock Text="Shows the frame, texture and memory counters of the in-game metrics panel in your browser. Keeps U9GL open while you play."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <CheckBox Content="Let other devices on my network open it (phone, tablet, another PC)" Margin="0,8,0,0"
                          IsChecked="{Binding WebDashboard.Network}" IsEnabled="{Binding WebDashboard.CanChange}" />
                <TextBlock Text="They need the link below, which carries a secret: anyone without it is turned away. The dashboard is read only. Windows may ask once whether to let U9GL through the firewall; allow it on private networks."
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="24,4,0,0" />
                <DockPanel Margin="24,6,0,0">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WebDashboard.NetworkLink}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <Button DockPanel.Dock="Right" Content="New link" Command="{Binding WebDashboard.NewLinkCommand}" Padding="12,4" Margin="8,0,0,0"
                            ToolTip="Make a new secret; links given out before stop working." />
                    <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding WebDashboard.CopyLinkCommand}" Padding="12,4" Margin="8,0,0,0" />
                    <TextBox Text="{Binding WebDashboard.NetworkLink, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                </DockPanel>
                <Image Source="{Binding WebDashboard.NetworkQr}" Width="168" Height="168" HorizontalAlignment="Left" Margin="24,8,0,0"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" ToolTip="Scan with a phone's camera to open the dashboard.">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WebDashboard.NetworkQr}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock Text="{Binding WebDashboard.OtherNetworkLinks}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="24,4,0,0" />
                <TextBlock Text="{Binding WebDashboard.Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding TelemetryFeedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Open in browser" Command="{Binding WebDashboard.OpenCommand}" Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="Retry" Command="{Binding WebDashboard.RetryCommand}" Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="Turn on game feed" Command="{Binding TurnOnTelemetryFeedCommand}" Padding="16,6" />
                </WrapPanel>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
