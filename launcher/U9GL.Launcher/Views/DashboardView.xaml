<UserControl x:Class="U9GL.Launcher.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel DataContext="{Binding Main}">
        <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Checks the game and the U9GL files, and installs, updates, repairs or removes U9GL."
                   Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />

        <Border Style="{StaticResource CardStyle}"
                Visibility="{Binding ErrorText, Converter={StaticResource TextToVisibility}}">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorTextStyle}" />
        </Border>

        <TextBlock Text="Game" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnDefinitions="130, *" RowDefinitions="Auto, Auto, Auto, Auto">
                <TextBlock Grid.Row="0" Text="Folder" Margin="0,0,0,8" />
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenGameFolderCommand}" Padding="12,2" />
                    <TextBlock Text="{Binding GameFolderPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="1" Text="Build" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{Binding BuildTone, Converter={StaticResource ToneBrush}}" />

                <TextBlock Grid.Row="2" Text="Renderer setting" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RasterizerText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{Binding RasterizerTone, Converter={StaticResource ToneBrush}}" />

                <TextBlock Grid.Row="3" Text="Folder access" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WritableText}" TextWrapping="Wrap"
                           Foreground="{Binding WritableTone, Converter={StaticResource ToneBrush}}" />
            </Grid>
        </Border>
        <TextBlock Text="{Binding RunningText}" Style="{StaticResource WarningTextStyle}" Margin="0,0,0,8"
                   Visibility="{Binding RunningText, Converter={StaticResource TextToVisibility}}" />
        <TextBlock Text="{Binding VirtualStoreText}" Style="{StaticResource WarningTextStyle}" Margin="0,0,0,8"
                   Visibility="{Binding VirtualStoreText, Converter={StaticResource TextToVisibility}}" />

        <TextBlock Text="Game data" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardStyle}" DataContext="{Binding GameData}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding DashboardRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="150, 130, *" Margin="0,3">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Grid.Column="1" Text="{Binding ShortStatus}" FontWeight="SemiBold"
                                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                           Visibility="{Binding ProgressText, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </Border>

        <TextBlock Text="U9GL files" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardStyle}">
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="150, 80, 130, *" Margin="0,3">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Text="{Binding VersionText}" />
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                            <TextBlock Grid.Column="3" Text="{Binding Note}" Style="{StaticResource SecondaryTextStyle}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <WrapPanel Margin="0,4,0,0">
            <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Padding="22,6" Margin="0,0,8,8" />
            <Button Content="Uninstall" Command="{Binding UninstallCommand}" Padding="16,6" Margin="0,0,8,8" />
            <Button Content="Check again" Command="{Binding RefreshCommand}" Padding="16,6" Margin="0,0,8,8" />
            <Button Content="Check game data" Command="{Binding GameData.CheckCommand}" Padding="16,6" Margin="0,0,8,8"
                    ToolTip="Reads every shipped data file and compares it with the release, by SHA-256. About a gigabyte; a few seconds." />
            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Padding="16,6" Margin="0,0,8,8" />
            <Button Content="Open backups" Command="{Binding OpenBackupFolderCommand}" Padding="16,6" Margin="0,0,8,8" />
        </WrapPanel>

        <TextBlock Text="Last Change:" Style="{StaticResource SectionTitleStyle}" />
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <TextBlock Text="Nothing yet this session." Style="{StaticResource SecondaryTextStyle}" />
                <ItemsControl ItemsSource="{Binding LastActions}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
