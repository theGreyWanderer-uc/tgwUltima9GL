<UserControl x:Class="U9GL.Launcher.Views.DataPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:U9GL.Launcher.ViewModels">
    <UserControl.Resources>
        <Style x:Key="GridCellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridResultText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding ResultTone, Converter={StaticResource ToneBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground"
                            Value="{Binding ResultTone, Converter={StaticResource ToneBrush}, ConverterParameter=bright}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ReportTemplate" DataType="{x:Type vm:ReportViewModel}">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding AssessmentTitle}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{Binding AssessmentTone, Converter={StaticResource ToneBrush}}" />
                        <TextBlock Text="{Binding AssessmentText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding LoadText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding WhatToDo}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding WhatToDo, Converter={StaticResource TextToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Axes}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AxisRow}">
                                    <Grid ColumnDefinitions="130, 110, *" Margin="0,3">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Verdict}" FontWeight="SemiBold"
                                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Meaning}" Style="{StaticResource SecondaryTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding CardsTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,8"
                           Visibility="{Binding HasCards, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CardRow}">
                            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Badge}" FontWeight="SemiBold" Width="70"
                                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <StackPanel Margin="70,4,0,0">
                                        <TextBlock Text="{Binding Meanings}" TextWrapping="Wrap" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                                            <Run Text="What you can do:" FontWeight="SemiBold" /> <Run Text="{Binding WhatToDo, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="Loading:" FontWeight="SemiBold" /> <Run Text="{Binding LoadText, Mode=OneWay}" />
                                        </TextBlock>
                                        <Expander Header="Details" Margin="0,6,0,0">
                                            <StackPanel Margin="8,4,0,0">
                                                <TextBlock Text="{Binding Technical}" Style="{StaticResource SecondaryTextStyle}"
                                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Sources}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Visibility="{Binding Sources, Converter={StaticResource TextToVisibility}}" />
                                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" FontFamily="Consolas" FontSize="11" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="{Binding EvidenceTitle}" Margin="0,4,0,4">
                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="8,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" FontFamily="Consolas" FontSize="11" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Save data" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,16"
                   Text="Checks saved games against the game's file formats: that the working files came from the save, that each file is intact inside, and that what the save points at exists in the map files. Nothing here changes a game file: backups and saved reports go to Documents\U9GL." />

        <Border Style="{StaticResource CardStyle}" DataContext="{Binding Snapshot}">
            <StackPanel>
                <TextBlock Text="New-game snapshot" Style="{StaticResource CardTitleStyle}" FontSize="16" />

                <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        Visibility="{Binding Missing, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource CautionIconInfoBadgeStyle}"
                                        Margin="0,2,12,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="No new-game snapshot exists. Make one now." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="The journal's New Game starts from a snapshot of the game's opening, and the game as GOG and Steam sell it ships without one. Without it, a new game from the journal skips the opening and keeps your old game's house: the toolbelt, backpack and journal are not on the table, and the game cannot be played properly." />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="U9GL can make it: the game starts on a new game, the opening plays, and at the first hint ankh U9GL saves the snapshot and closes the game. About 2 minutes; don't touch anything while it runs. Your current game is set aside and put back. It needs the game's own data files, so make it before installing fan patches. The intro video does not have to play: you may skip it with Escape. After that, wait until the game closes." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Make the new-game snapshot" Command="{Binding MakeCommand}"
                                        Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                                <ProgressBar IsIndeterminate="True" Width="160" Height="4" Margin="16,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="{Binding PresentText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding PresentText, Converter={StaticResource TextToVisibility}}" />

                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{Binding ResultTone, Converter={StaticResource ToneBrush}}"
                           Visibility="{Binding ResultText, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}" ItemContainerStyle="{StaticResource SegmentTabItemStyle}">

            <TabItem Header="Current save">
                <StackPanel DataContext="{Binding Current}" Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" FontSize="16"
                                       Visibility="{Binding Title, Converter={StaticResource TextToVisibility}}" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryTextStyle}"
                                       Visibility="{Binding Details, Converter={StaticResource TextToVisibility}}" />
                            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}}" />
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding RunningNote}" Style="{StaticResource WarningTextStyle}" Margin="0,6,0,0"
                                       Visibility="{Binding RunningNote, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Check again" Command="{Binding CheckCommand}" Style="{DynamicResource AccentButtonStyle}"
                                Padding="16,6" Margin="0,0,8,8" />
                        <Button Content="Copy report" Command="{Binding CopyCommand}" Padding="16,6" Margin="0,0,8,8"
                                ToolTip="The full text report, for a bug report or the notes." />
                        <Button Content="Open save folder" Command="{Binding OpenFolderCommand}" Padding="16,6" Margin="0,0,8,8" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,8" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="{Binding BackupLabel}" Command="{Binding BackupCommand}" Padding="16,6" Margin="0,0,8,8"
                                ToolTip="{Binding BackupTip}" />
                        <Button Content="Back up and play" Command="{Binding BackUpAndPlayCommand}" Padding="16,6" Margin="0,0,8,8"
                                Visibility="{Binding OffersPlay, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Backs the save up, checks it again, and starts the game only if it still checks as one to try." />
                        <Button Content="{Binding OlderSaveLabel}" Command="{Binding OlderSaveCommand}" Padding="16,6" Margin="0,0,8,8"
                                ToolTip="The All saves tab: check an older save before loading it in the game." />
                        <Button Content="{Binding SaveReportLabel}" Command="{Binding SaveReportCommand}" Padding="16,6" Margin="0,0,8,8"
                                ToolTip="Writes the plain summary, the full report and its JSON to a new folder. Nothing is sent anywhere." />
                        <Button Content="Open backups" Command="{Binding OpenBackupsCommand}" Padding="16,6" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ActionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{Binding ActionTone, Converter={StaticResource ToneBrush}}"
                               Visibility="{Binding ActionText, Converter={StaticResource TextToVisibility}}" />

                    <ContentControl Content="{Binding Report}" ContentTemplate="{StaticResource ReportTemplate}"
                                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="All saves">
                <StackPanel DataContext="{Binding Saves}" Margin="0,16,0,0">
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding FolderNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource WarningTextStyle}" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,4,0,8">
                        <Button DockPanel.Dock="Left" Content="Check all" Command="{Binding CheckAllCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0"
                                ToolTip="Reads every save in full. Older saves are checked from their own files." />
                        <Button DockPanel.Dock="Left" Content="Stop" Command="{Binding CancelCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Left" Content="Rescan" Command="{Binding RescanCommand}" Padding="14,6" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Left" Content="Open folder" Command="{Binding OpenFolderCommand}" Padding="14,6" Margin="0,0,16,0" />
                        <CheckBox DockPanel.Dock="Right" Content="Problems only" IsChecked="{Binding ProblemsOnly}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="Filter by slot number, description or problem." />
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8"
                               Visibility="{Binding ProgressText, Converter={StaticResource TextToVisibility}}" />

                    <DataGrid x:Name="SavesGrid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                              SelectionChanged="ShowSelectedSave" IsVisibleChanged="ShowSelectedSave"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              Height="300" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                              CanUserResizeRows="False" CanUserReorderColumns="False" GridLinesVisibility="None"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" SortMemberPath="Slot" Width="56" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="" SortMemberPath="IsCurrent" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:SaveRowViewModel}">
                                        <Border x:Name="Badge" CornerRadius="4" Padding="7,1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="start.dat selects this save: the game loads it at start, and Play starts it.">
                                            <TextBlock x:Name="BadgeText" Text="current" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter TargetName="Badge" Property="Background" Value="White" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="Map" Binding="{Binding Map}" Width="52" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="Saved" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="128" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="72" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="Result" SortMemberPath="ResultRank" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:SaveRowViewModel}">
                                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource GridResultText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Fan patch" SortMemberPath="PatchText" Width="84">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:SaveRowViewModel}">
                                        <TextBlock Text="{Binding PatchText}" ToolTip="{Binding PatchTip}" FontWeight="SemiBold"
                                                   Style="{StaticResource GridCellText}"
                                                   Foreground="{Binding Source={x:Static vm:Tone.Warning}, Converter={StaticResource ToneBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,12"
                            DataContext="{Binding Selected}"
                            Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" FontSize="15">
                                <Run Text="Slot" /> <Run Text="{Binding Slot, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Description, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                <Run Text="{Binding Info.FileName, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding ModifiedText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{Binding ResultTone, Converter={StaticResource ToneBrush}}"
                                       Visibility="{Binding Summary, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Check this save" Command="{Binding CheckSelectedCommand}" Padding="16,6" Margin="0,0,8,8" />
                        <Button Content="Copy report" Command="{Binding CopyCommand}" Padding="16,6" Margin="0,0,8,8" />
                        <Button Content="{Binding BackupLabel}" Command="{Binding BackupCommand}" Padding="16,6" Margin="0,0,8,8"
                                ToolTip="Copies this save and the loose files in savegame to a new backup folder. Nothing in the game folder changes." />
                        <Button Content="{Binding SaveReportLabel}" Command="{Binding SaveReportCommand}" Padding="16,6" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ActionText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{Binding ActionTone, Converter={StaticResource ToneBrush}}"
                               Visibility="{Binding ActionText, Converter={StaticResource TextToVisibility}}" />
                    <ContentControl Content="{Binding Selected.Report}" ContentTemplate="{StaticResource ReportTemplate}" />

                    <Expander Header="{Binding OtherFilesTitle}" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding OtherFiles}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderFileRow}">
                                    <Grid ColumnDefinitions="120, 70, 128, *" Margin="0,3">
                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Note}" TextWrapping="Wrap"
                                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </TabItem>

            <TabItem Header="Static data">
                <StackPanel DataContext="{Binding Main.GameData}" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every file the game reads and never writes - u9.exe and the libraries it loads, static, sound, runtime and the movies - checked against the release by SHA-256. Settings, key bindings, saves, manuals and the installer's own files are not checked. Nothing here changes a file." />
                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding FanPatches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title, StringFormat={}{0}:}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding ShortStatus}" FontWeight="SemiBold" Margin="0,0,8,0"
                                               Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid DataContext="{Binding Saves}" ColumnDefinitions="Auto, Auto, *" Margin="0,0,0,8">
                        <TextBlock Text="Saves:" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ShortStatus}" FontWeight="SemiBold" Margin="0,0,8,0"
                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorTextStyle}" Margin="0,0,0,8"
                               Visibility="{Binding ErrorText, Converter={StaticResource TextToVisibility}}" />

                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Check files" Command="{Binding CheckCommand}" Style="{DynamicResource AccentButtonStyle}"
                                Padding="16,6" Margin="0,0,8,8"
                                ToolTip="Reads about a gigabyte and hashes every file. A few seconds." />
                        <Button Content="Stop" Command="{Binding CancelCommand}" Padding="14,6" Margin="0,0,8,8" />
                    </WrapPanel>

                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,0,0,4"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8"
                               Visibility="{Binding ProgressText, Converter={StaticResource TextToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameDataFolderViewModel}">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="15"
                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" FontSize="15" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,2,0,6" />
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CheckedText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"
                                                   Visibility="{Binding CheckedText, Converter={StaticResource TextToVisibility}}" />

                                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0"
                                                      Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:GameDataFileRow}">
                                                    <Grid ColumnDefinitions="170, 110, *" Margin="0,2">
                                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding State}" FontWeight="SemiBold"
                                                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource SecondaryTextStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Expander Header="What this compares against" Margin="0,4,0,12">
                        <StackPanel Margin="8,8,0,0">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                                       Text="A file is OK when its contents are exactly what the release shipped. A changed file is not a fault in itself - it is what modding the game looks like - but it explains behaviour the shipped game would not have. Missing files are the ones to worry about." />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"
                                       Text="The savegame folder is not checked here: it is yours, and the Current save and All saves tabs cover it." />
                            <ItemsControl ItemsSource="{Binding ManifestNotes}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
