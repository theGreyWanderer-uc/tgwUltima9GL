<UserControl x:Class="U9GL.Launcher.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:U9GL.Launcher.Views">
    <Grid RowDefinitions="Auto, *, Auto"
          MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer},
                              Converter={StaticResource Subtract}, ConverterParameter=48}">
        <StackPanel>
            <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Text="U9GL" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Text="An OpenGL renderer for Ultima IX: Ascension, with fixes for crashes in the game. It needs your own copy of the game, the GOG release, and includes no game data." />
                    <Grid ColumnDefinitions="*, Auto" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Main.AboutDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="1" Content="Copy" Command="{Binding Main.CopyDetailsCommand}" VerticalAlignment="Top"
                                Padding="16,4" ToolTip="Copies these lines, for a bug report." />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Animate the logo" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Play the shining ankh on this page. It plays only while Windows is in light mode, the background it was made on; otherwise the still picture shows."
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="Default: On" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding Main.AnimateAbout}"
                              VerticalAlignment="Center" AutomationProperties.Name="Animate the logo" />
                </Grid>
            </Border>

            <TextBlock Text="Where U9GL writes" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <ItemsControl ItemsSource="{Binding Main.WriteLocations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,14">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryTextStyle}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenCommand}"
                                        VerticalAlignment="Center" Padding="16,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <views:AboutArt Grid.Row="2"
               Width="320" Height="320" Margin="0,16,0,0"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                    Converter={StaticResource AtLeastVisible}, ConverterParameter=!1184}" />
    </Grid>
</UserControl>
