<Window x:Class="U9GL.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:U9GL.Launcher.ViewModels"
        xmlns:views="clr-namespace:U9GL.Launcher.Views"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Resources/U9GL.ico"
        Width="1040" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Activated="OnActivated">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardPage}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebDashboardPage}"><views:WebDashboardPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPage}"><views:SettingsPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FixesPage}"><views:FixesPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsPage}"><views:DiagnosticsPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExperimentalPage}"><views:ExperimentalPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataPage}"><views:DataPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutPage}"><views:AboutView /></DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="*, Auto" ColumnDefinitions="210, *">

        <DockPanel Grid.Row="0" Grid.Column="0" Margin="12,20,4,12">
            <StackPanel DockPanel.Dock="Top" Margin="10,0,8,20">
                <TextBlock Text="U9GL" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage}"
                     DisplayMemberPath="Title"
                     BorderThickness="0"
                     Background="Transparent" />
        </DockPanel>

        <ScrollViewer x:Name="PageScroll" Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding SelectedPage}"
                            Margin="32,24,32,24"
                            HorizontalAlignment="Left">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="MaxWidth" Value="780" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPage.Title}" Value="Fixes">
                                <Setter Property="MaxWidth" Value="1240" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage.Title}" Value="Diagnostics">
                                <Setter Property="MaxWidth" Value="1240" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage.Title}" Value="Graphics">
                                <Setter Property="MaxWidth" Value="1240" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage.Title}" Value="Game">
                                <Setter Property="MaxWidth" Value="1240" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </ScrollViewer>

        <views:AboutArt Grid.Row="0" Grid.Column="1"
               Width="320" Height="320" Margin="0,0,28,20"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <views:AboutArt.Style>
                <Style TargetType="views:AboutArt">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage.Title}" Value="About">
                            <Setter Property="Visibility"
                                    Value="{Binding ActualWidth, ElementName=PageScroll,
                                            Converter={StaticResource AtLeastVisible}, ConverterParameter=1184}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:AboutArt.Style>
        </views:AboutArt>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="24,12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusTone, Converter={StaticResource ToneBrush}}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusDetail}"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Content="Close U9GL when the game starts"
                              IsChecked="{Binding CloseOnPlay}"
                              IsEnabled="{Binding CanCloseOnPlay}"
                              ToolTip="The web dashboard keeps U9GL open while enabled."
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />
                    <Button Content="Revert" Command="{Binding RevertCommand}" Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Padding="20,6" Margin="0,0,8,0" />
                    <Button Content="Play" Command="{Binding PlayCommand}"
                            Style="{DynamicResource AccentButtonStyle}" Padding="30,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
