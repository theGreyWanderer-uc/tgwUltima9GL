<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);Frontend\node_modules\**;Frontend\dist\**;Frontend\test-results\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\U9GL.Core\U9GL.Core.csproj" />
    <InternalsVisibleTo Include="U9GL.WebDashboard.Tests" />
  </ItemGroup>
  <ItemGroup>
    <DashboardFrontendSource Include="Frontend\src\**\*;Frontend\public\**\*;Frontend\package*.json;Frontend\*.mjs;Frontend\tsconfig.json;Frontend\index.html" />
  </ItemGroup>
  <Target Name="BuildDashboardFrontend" Inputs="@(DashboardFrontendSource)" Outputs="Frontend\dist\.buildstamp">
    <Exec Command="npm ci --no-fund --no-audit" WorkingDirectory="Frontend" />
    <Exec Command="npm run build" WorkingDirectory="Frontend" />
    <Touch Files="Frontend\dist\.buildstamp" AlwaysCreate="true" />
  </Target>
  <Target Name="EmbedDashboardFrontend" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildDashboardFrontend">
    <Error Condition="!Exists('Frontend\dist\index.html')" Text="Web dashboard: frontend build is missing." />
    <ItemGroup>
      <DashboardAsset Include="Frontend\dist\**\*" Exclude="Frontend\dist\.buildstamp" />
      <EmbeddedResource Include="@(DashboardAsset)">
        <LogicalName>frontend/%(DashboardAsset.RecursiveDir)%(DashboardAsset.Filename)%(DashboardAsset.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
